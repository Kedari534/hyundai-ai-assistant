# ============================================================
# Hyundai AI Assistant — Backend Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- Database (Supabase PostgreSQL) -------------------------
# Get from: Supabase Dashboard → Project Settings → Database
DB_URL=jdbc:postgresql://db.YOURPROJECTREF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# --- JWT ----------------------------------------------------
# Generate: openssl rand -hex 64
# Must be at least 64 characters (512 bits for HS512)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_EXPIRY_MS=3600000
JWT_REFRESH_EXPIRY_MS=604800000

# --- Google AI Studio (FREE tier) --------------------------
# Get from: https://aistudio.google.com/app/apikey
# Free: 15 RPM chat, 1500 req/day, 1M tokens/day (Gemini Flash)
GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
SPRING_AI_GOOGLE_GENAI_CHAT_MODEL=gemini-3.5-flash-lite
SPRING_AI_GOOGLE_GENAI_EMBEDDING_MODEL=gemini-embedding-001
SPRING_AI_GOOGLE_GENAI_EMBEDDING_DIMENSIONS=1536

# --- Supabase Storage (for PDF files) ----------------------
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOURPROJECTREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=brochures

# --- CORS ---------------------------------------------------
# Your Cloudflare Pages URL (set after frontend deploy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.pages.dev

# --- Ingestion Config ---------------------------------------
APP_STORAGE_MODE=local
INGESTION_CHUNK_SIZE=1600
INGESTION_CHUNK_OVERLAP=200
INGESTION_MAX_FILE_SIZE_MB=20

# --- Server -------------------------------------------------
SERVER_PORT=8080
